 usecase "UC002\nCập nhật Load\n(UI đang bị tắt)" as E
 usecase "UC003\nXem chi tiết Load" as D
 usecase "UC004\nXem timeline Load" as T
}
U -- C
U -- E
U -- D
U -- T
