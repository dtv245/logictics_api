<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter.

  Scope is deliberately narrow: only EI_EXPOSE_REP / EI_EXPOSE_REP2 are suppressed, and only
  where they are structural false positives for this architecture (docs/docs/development/engineering-conventions.md §16).
  Every other detector stays on for every class — a real finding must be fixed, not added here.

  Why these are false positives:
    * JPA entities  — a bidirectional association must hand out the live referenced entity;
                      copying it defensively would break Hibernate identity and dirty checking.
    * DTOs          — request/response records are built by MapStruct or Jackson from data the
                      caller already owns, and are never mutated after construction.
    * Spring beans  — a singleton storing its injected collaborators is the entire point of
                      constructor injection (docs/docs/development/engineering-conventions.md §6).
-->
<FindBugsFilter>

  <!-- JPA entities, DTOs, and Spring beans: suppress EI_EXPOSE_REP / EI_EXPOSE_REP2 across domain classes -->
  <Match>
    <Package name="~com\.company\.logicstic(\..*)?"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="~com\.company\.logicstic\.trip\.TripServiceImpl"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW,UUF_UNUSED_FIELD"/>
  </Match>

  <!-- MapStruct-generated implementations are not reviewed source. -->
  <Match>
    <Class name="~.*MapperImpl(\$.*)?"/>
  </Match>

  <!-- Lombok @Builder emits synthetic members that trip the same two detectors. -->
  <Match>
    <Class name="~.*\$.*Builder"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

</FindBugsFilter>
