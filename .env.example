# Copy this file to .env and replace local values as needed.
SERVER_PORT=8080

# Required when running with database auto-configuration enabled.
DB_URL=jdbc:postgresql://localhost:5433/us_logisticsx
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Supply real values from the deployment secret manager before creating driver records.
# AES keys are Base64-encoded 32-byte values; retain old key-id entries during key rotation.
DRIVER_PII_ACTIVE_KEY_ID=
DRIVER_PII_ENCRYPTION_KEYS=
DRIVER_PII_INDEX_KEY=
DRIVER_PROFILE_EXPIRY_WARNING_DAYS=30
DRIVER_PROFILE_TIME_ZONE=Asia/Ho_Chi_Minh
DRIVER_PROFILE_EXPIRY_SCAN_ENABLED=true
DRIVER_PROFILE_EXPIRY_SCAN_CRON=0 0 8 * * *

# Lark Integration & OAuth
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=http://localhost:5173/auth/callback
LARK_BASE_URL=https://open.larksuite.com
LARK_JWT_SECRET=

# Lark Event Receiver: provision credentials outside the repository; empty values fail closed.
LARK_EVENT_VERIFICATION_TOKEN=
LARK_EVENT_ENCRYPT_KEY=

# Lark Base (Bitable) Data Sync
LARK_BASE_ENABLED=false
LARK_BASE_APP_TOKEN=
LARK_BASE_LOADS_TABLE_ID=
LARK_BASE_DRIVERS_TABLE_ID=

# Base writes stay disabled until the sandbox is configured and validated.
LARK_BASE_ENVIRONMENT=sandbox
LARK_BASE_DELIVERY_TIME_ZONE=Asia/Ho_Chi_Minh
LARK_BASE_LOAD_ID_FIELD=TMS ID
LARK_BASE_LOAD_NUMBER_FIELD=Load Number
LARK_BASE_LOAD_NAME_FIELD=Load Name
LARK_BASE_LOAD_STATUS_FIELD=Status
LARK_BASE_LOAD_CUSTOMER_FIELD=Customer
LARK_BASE_LOAD_TRUCK_FIELD=Truck Number
LARK_BASE_LOAD_DISPATCHER_FIELD=Dispatcher
LARK_BASE_LOAD_DELIVERY_DATE_FIELD=Delivery Date
LARK_BASE_LOAD_DELIVERY_ZONE_FIELD=Delivery Time Zone
LARK_BASE_LOAD_LIFECYCLE_FIELD=TMS Lifecycle
LARK_BASE_DRIVER_ID_FIELD=TMS ID
LARK_BASE_DRIVER_NAME_FIELD=Full Name
LARK_BASE_DRIVER_EMAIL_FIELD=Email
LARK_BASE_DRIVER_PHONE_FIELD=Phone
LARK_BASE_DRIVER_STATUS_FIELD=Status
LARK_BASE_DRIVER_SALARY_TYPE_FIELD=Salary Type
LARK_BASE_DRIVER_LIFECYCLE_FIELD=TMS Lifecycle

# Optional local AI provider key; provide it through your secret manager.
GROQ_API_KEY=
