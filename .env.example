# Copy this file to .env and replace local values as needed.
#
# .env carries credentials and ports ONLY (CONVENTIONS.md §11).
#
# Do NOT put SPRING_PROFILES_ACTIVE here. application.yml imports this file, and tests read the
# same configuration — so a profile set here silently activates in every Spring test, every
# @Profile("!nodb") bean disappears from the context, and requests fall through to the
# static-resource handler as a 404 that never mentions profiles.
# Choose the profile on the run configuration instead:  --spring.profiles.active=nodb

SERVER_PORT=8080

# ── Running on the host (mvn spring-boot:run) ────────────────────────────────
# Required when running with database auto-configuration enabled.
DB_URL=jdbc:postgresql://localhost:5433/us_logisticsx
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ── Running the Docker stack (docker compose up) ─────────────────────────────
# docker-compose.yml builds DB_URL/DB_USERNAME/DB_PASSWORD from these, pointing
# at the `postgres` service instead of localhost. The two blocks coexist: the
# host block is what application.yml imports, this block is what compose reads.
POSTGRES_DB=us_logisticsx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Host-side published port. 5433 keeps out of the way of a PostgreSQL already
# installed on the machine, which usually owns 5432.
POSTGRES_PORT=5433
API_PORT=8080

# SPRING_PROFILES_ACTIVE is deliberately NOT here, for the reason at the top of
# this file. docker-compose.yml defaults the container to `dev`; to override it
# for one run, export it in the shell instead of writing it to .env:
#   SPRING_PROFILES_ACTIVE=staging docker compose up -d

# Identity server (no defaults in application.yml — a resource server must never fall back to a
# localhost issuer). The nodb profile supplies local values for these.
AUTH_ISSUER_URI=https://localhost:7001
AUTH_AUDIENCE=logisticsx.api
AUTH_JWK_SET_URI=https://localhost:7001/.well-known/openid-configuration/jwks

# Redis cache. Every cache bean is off unless CACHE_ENABLED=true; the local/dev/staging/prod
# profiles default it to true, so this only needs setting to turn caching OFF.
# Keys are <prefix>:<tenant>:<cache>:<id> — the tenant segment is mandatory because this is a
# database-per-tenant system and the same primary key exists in every tenant database.
# CACHE_ENABLED is NOT set here, for the same reason as SPRING_PROFILES_ACTIVE: application.yml
# imports this file and tests read the same configuration. The profiles default it to true; compose
# passes its own value as a container environment variable.
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty means no auth, which is the normal state of a local Redis. Production re-declares this
# without a default, so an unset value there fails the boot instead of connecting unauthenticated.
REDIS_PASSWORD=

# Multi-tenancy (§14). Every tenancy bean is off unless this flag is true.
TENANCY_ENABLED=false
# Required only when TENANCY_ENABLED=true:
# TENANT_REGISTRY_DB_URL=jdbc:postgresql://localhost:5433/logisticsx_registry
# TENANT_REGISTRY_DB_USERNAME=postgres
# TENANT_REGISTRY_DB_PASSWORD=change-me
# TENANT_REGISTRY_ENCRYPTION_KEY=change-me
# TENANT_PROVISIONING_ADMIN_DB_URL=jdbc:postgresql://localhost:5433/postgres
# TENANT_PROVISIONING_ADMIN_DB_USERNAME=postgres
# TENANT_PROVISIONING_ADMIN_DB_PASSWORD=change-me
# TENANT_TEMPLATE_DATABASE=logisticsx_template
