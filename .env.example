# Copy this file to .env and replace local values as needed.
SPRING_PROFILES_ACTIVE=nodb
SERVER_PORT=8080

# Required when running with database auto-configuration enabled.
DB_URL=jdbc:postgresql://localhost:5433/us_logisticsx
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Lark Integration & OAuth
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
LARK_REDIRECT_URI=http://localhost:5173/auth/callback
LARK_BASE_URL=https://open.larksuite.com
LARK_JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits

# Lark Base (Bitable) Data Sync
LARK_BASE_ENABLED=true
LARK_BASE_APP_TOKEN=bascnxxxxxxxxxxxx
LARK_BASE_LOADS_TABLE_ID=tblxxxxxxxxxxxx
LARK_BASE_DRIVERS_TABLE_ID=tblxxxxxxxxxxxx
